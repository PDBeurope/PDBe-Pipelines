nextflow_process {

    name "Test Process run_fix_protonated_cif"
    script "modules/run_fix_protonated_cif.nf"
    process "run_fix_protonated_cif"

    test("Should run without failures") {

        when {
            params {
                meta = [
                    id:"test",
                ]
                test_loc="${projectDir}/tests/test_data"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = tuple(
                    params.meta,
                    file("${params.test_loc}/1cbs_bio_h_before_fix.cif"),
                    file("${params.test_loc}/1cbs_bio.cif")
                    )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}