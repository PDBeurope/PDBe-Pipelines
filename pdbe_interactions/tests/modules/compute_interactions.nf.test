nextflow_process {

    name "Test Process compute_interactions"
    script "modules/compute_interactions.nf"
    process "compute_interactions"

    test("Should run without failures") {

        when {
            params {
                meta = [
                    id:"test",
                ]
                test_loc="${projectDir}/tests/test_data"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = tuple(
                    params.meta,
                    file("${params.test_loc}/1cbs_bio_h.cif"),
                    file("${params.test_loc}/1cbs_bound_molecules.json")
                    )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}